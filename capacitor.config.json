{
  "appId": "es.dedicalo.play",
  "appName": "Dedícalo",
  "webDir": "dist",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "always" },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#071025",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#071025",
      "overlaysWebView": true
    }
  }
}
